# Input data and intermediates (not distributed)
#
# raw/ is listed with a tracked placeholder so the directory exists after a
# clone and it is obvious where the OhioT1DM training files go. Add an empty
# raw/.gitkeep to the repository for this to take effect.
raw/*
!raw/.gitkeep

processed/

# Synthetic data. Regenerated by the orchestrator whenever DEMO is True, and
# by S.GenerateSampleData.py on demand, so there is nothing to version. The
# generator is deterministic: the same seed and day count produce the same
# files.
sample_data/

# Synthetic outputs. Written to demo_output/ when DEMO is True, so a demo
# run cannot overwrite the tracked tables under results/tables/.
demo_output/

# Figures are reproduced by running the pipeline; the tables under
# results/tables/ ARE tracked, so the reported values can be checked
# without access to the OhioT1DM dataset.
results/figures/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
venv/
env/
.env

# Editors
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
